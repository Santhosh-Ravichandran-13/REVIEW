
#include <stdio.h>
#include <stdlib.h>


void sortColors(int array[], int size)
{
    int i;
    int count0 = 0, count1 = 0, count2 = 0;
    
 
    for (i = 0; i < size; i++)
    {
        if (array[i] == 0)
            count0++;
        else if (array[i] == 1)
            count1++;
        else
            count2++;
    }
 
    for (i = 0; i < count0; i++)
    {
        array[i] = 0;
    }
    
   
    for (i = count0; i < count0 + count1; i++)
    {
        array[i] = 1;
    }
    
    
    for (i = count0 + count1; i < size; i++)
    {
        array[i] = 2;
    }
}

void displayArray(int array[], int size)
{
    int i;
    printf("[");
    for (i = 0; i < size; i++)
    {
        printf("%d", array[i]);
        if (i < size - 1)
            printf(", ");
    }
    printf("]\n");
}

int main()
{
    printf("Sort Array with 0s, 1s, and 2s - Runtime Input\n");
    printf("==============================================\n\n");
    
    int size;
    int i;
    
    /* Get array size from user */
    printf("Enter array size: ");
    scanf("%d", &size);
    
    int *array = (int *)malloc(size * sizeof(int));
    
    if (array == NULL)
    {
        printf("Memory allocation failed\n");
        return 1;
    }
    
   
    printf("Enter %d numbers (only 0, 1, or 2):\n", size);
    for (i = 0; i < size; i++)
    {
        printf("Number %d: ", i + 1);
        scanf("%d", &array[i]);
     
        if (array[i] < 0 || array[i] > 2)
        {
            printf("Invalid! Please enter only 0, 1, or 2\n");
            i--;
        }
    }
    
    printf("\nBefore sorting: ");
    displayArray(array, size);
    
    
    sortColors(array, size);
    
    
    printf("After sorting:  ");
    displayArray(array, size);
    
    
    free(array);
    
    return 0;
}

